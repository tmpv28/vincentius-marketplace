{
  "name": "react-ts-starter",
  "version": "0.1.0",
  "description": "React with TypeScript | Personal starter that ships the TV-STANDARD conventions out of the box.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "pnpm exec eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "pnpm exec eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:styles": "pnpm exec stylelint \"src/**/*.scss\"",
    "std:check": "node scripts/standardCheck.js",
    "test:watch": "vitest",
    "test:no-watch": "vitest run",
    "test:unit": "vitest run --environment jsdom",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^7.16.2",
    "@mantine/hooks": "^7.16.2",
    "axios": "^1.20.0",
    "date-fns": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/builder-vite": "^9.1.13",
    "@storybook/react-vite": "^9.1.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chalk": "^5.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "prettier": "^3.0.3",
    "sass": "^1.69.7",
    "storybook": "^9.1.13",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
