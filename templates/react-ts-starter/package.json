{
  "name": "react-ts-starter",
  "version": "0.1.0",
  "description": "React with TypeScript | Personal starter that ships the TV-STANDARD conventions out of the box.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "npx eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "npx eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:styles": "npx stylelint \"src/**/*.scss\"",
    "std:check": "node scripts/standardCheck.js",
    "test:watch": "vitest",
    "test:no-watch": "vitest run",
    "test:unit": "vitest run --environment jsdom",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^7.16.2",
    "@mantine/hooks": "^7.16.2",
    "axios": "^1.20.0",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/builder-vite": "^9.1.13",
    "@storybook/react-vite": "^9.1.13",
    "@testing-library/jest-dom": "^6.1.3",
    "@vitest/coverage-v8": "^3.2.6",
    "@testing-library/react": "^16.1.0",
    "@types/lodash": "^4.17.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.6.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^9.1.13",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.0.3",
    "sass": "^1.69.7",
    "storybook": "^9.1.13",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^6.2.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.6"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
